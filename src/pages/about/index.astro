---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const portrait = import.meta.glob('/src/assets/portrait/*', { eager: true }) as Record<
  string,
  { default: ImageMetadata }
>;
const portraitSrc = portrait['/src/assets/portrait/siril.png']?.default;

const education = [
  {
    period: '2022—2025',
    title: 'PhD, Mechanical Engineering (Biomechanics)',
    place: 'McGill University, Montréal',
    note: 'Musculoskeletal Biomechanics Research Lab, supervised by Prof. Mark Driscoll.',
  },
  {
    period: '2020—2021',
    title: 'MS, Mechanical Engineering (fast-track)',
    place: 'McGill University, Montréal',
    note: 'Fast-tracked into the PhD with a 4.0 GPA.',
  },
  {
    period: '2016—2020',
    title: 'B.Tech, Mechanical Engineering (Minor in Design)',
    place: 'Manipal Institute of Technology, India',
    note: "Bachelor's thesis on self-healing soft robotics at the R&MM Research Group, Vrije Universiteit Brussel. Graduated with distinction.",
  },
];

const appointments = [
  { period: '2022—2023', role: 'Vice President of Academics', org: 'GAMES, McGill' },
  { period: '2023—2024', role: 'TA Union Representative', org: 'AGSEM' },
  { period: '2022—2025', role: 'Judge, SURE Program', org: 'McGill University' },
  { period: '2016—2019', role: 'Research Team Lead', org: 'Mars Rover Manipal' },
];
---

<BaseLayout
  title="Siril - About"
  description="About Siril Dukkipati: postdoctoral researcher at MDsim Luxembourg, working across computational and experimental biomechanics and model verification & validation."
>
  <section class="page-head">
    <div class="container">
      <SectionHeader num="06" label="About" heading="Siril Teja Dukkipati" />
    </div>
  </section>

  <section class="container about-grid">
    <figure class="portrait" data-reveal>
      {
        portraitSrc && (
          <Image
            src={portraitSrc}
            alt="Black-and-white portrait of Siril Dukkipati"
            widths={[560, 800, 1086]}
            sizes="(max-width: 60rem) 100vw, 30rem"
            loading="eager"
          />
        )
      }
    </figure>

    <div class="about-body">
      <div class="prose lede-block" data-reveal>
        <p>
          I am a postdoctoral researcher at
          <a href="https://mdsim.health" target="_blank" rel="noopener noreferrer">MDsim S.A.</a>
          in Luxembourg, working on the biomechanical verification and clinical validation of
          <a href="https://mdsim.health" target="_blank" rel="noopener noreferrer">SPINEsim</a> — a
          patient-specific digital twin platform for spine surgical planning. The position is
          funded by the
          <a href="https://www.fnr.lu" target="_blank" rel="noopener noreferrer"
            >Luxembourg National Research Fund (FNR)</a
          >, with clinical validation in collaboration with the
          <a
            href="https://www.uni-ulm.de/med/institut-fuer-unfallchirurgische-forschung-und-biomechanik/forschungsfelder/biomechanik-der-wirbelsaeule/"
            target="_blank" rel="noopener noreferrer">Institute of Orthopaedic Research and Biomechanics</a
          >
          at the University of Ulm.
        </p>
        <p>
          Before that, I completed my PhD in Mechanical Engineering (Biomechanics) at
          <a href="https://www.mcgill.ca" target="_blank" rel="noopener noreferrer">McGill University</a>
          in the
          <a href="https://www.mcgill.ca/mbr" target="_blank" rel="noopener noreferrer"
            >Musculoskeletal Biomechanics Research Lab</a
          >
          under
          <a
            href="https://www.mcgill.ca/mecheng/people/staff/mark-driscoll"
            target="_blank" rel="noopener noreferrer">Prof. Mark Driscoll</a
          > — developing and validating a robotic benchtop spinal model, 3D-printable analogue spine
          surrogates, and high-fidelity MATLAB rigid-body spine models inclusive of
          intra-abdominal pressure.
        </p>
        <p>
          My broader interests span musculoskeletal modelling, robotics and control, and
          experimental validation, with translational applications in digital health and medical
          device development. The focus of my work is bringing computational models closer to
          clinical practice, and validating them rigorously enough to be trusted.
        </p>
        <p>
          I hold a bachelor's degree in Mechanical Engineering from
          <a href="https://manipal.edu/mu.html" target="_blank" rel="noopener noreferrer"
            >Manipal University</a
          >, and completed my bachelor's thesis with the
          <a
            href="https://www.brubotics.eu/research/self-healing-research"
            target="_blank" rel="noopener noreferrer">R&amp;MM Research Group</a
          >
          at the Vrije Universiteit Brussel, designing and prototyping a self-healing soft robotic
          gripper. Earlier, I led a robotics team to first place at the
          <a
            href="https://southasia.marssociety.org/indianroverchallenge/"
            target="_blank" rel="noopener noreferrer">Indian Rover Challenge</a
          >
          and promoted space education with the
          <a href="https://southasia.marssociety.org/" target="_blank" rel="noopener noreferrer"
            >Mars Society</a
          >
          community.
        </p>
      </div>

      <div class="outside" data-reveal>
        <p class="meta outside-kicker">Outside the lab</p>
        <p class="outside-text">
          Landscape and travel <a class="text-link" href="https://www.instagram.com/siril.td/" target="_blank" rel="noopener noreferrer">photography</a>,
          road <a class="text-link" href="https://www.strava.com/athletes/82563036" target="_blank" rel="noopener noreferrer">cycling</a>,
          and long-distance summer biking trips.
        </p>
      </div>

      <div class="actions" data-reveal>
        <a class="btn btn--solid" href="/cv/Siril_Dukkipati_CV.pdf" target="_blank" rel="noopener noreferrer">Download CV</a>
        <a class="arrow-link" href="mailto:siril.dukkipati@mdsim.health">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="container records">
    <div class="record-col">
      <h2 class="group-heading" data-reveal>Education</h2>
      <ul class="record-list" role="list">
        {
          education.map((e) => (
            <li data-reveal>
              <p class="meta record-period">{e.period}</p>
              <p class="record-title">{e.title}</p>
              <p class="record-place">{e.place}</p>
              <p class="record-note">{e.note}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="record-col">
      <h2 class="group-heading" data-reveal>Selected appointments</h2>
      <ul class="record-list" role="list">
        {
          appointments.map((a) => (
            <li data-reveal>
              <p class="meta record-period">{a.period}</p>
              <p class="record-title">{a.role}</p>
              <p class="record-place">{a.org}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3.5rem, 8vh, 6rem) clamp(1rem, 2vh, 2rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .portrait {
    margin: 0;
    position: sticky;
    top: 6rem;
  }
  .portrait img {
    width: 100%;
    height: auto;
  }

  .about-body {
    display: grid;
    gap: 2.5rem;
  }
  .lede-block {
    font-size: 1.02rem;
  }
  .lede-block p + p {
    margin-top: 1.1em;
  }

  .outside {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: 1.5rem;
    display: grid;
    gap: 0.4rem;
  }
  .outside-kicker {
    color: var(--accent);
  }
  .outside-text {
    color: var(--text-2);
    max-width: 56ch;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .records {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: var(--space-section);
  }
  .group-heading {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
  }
  .record-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }
  .record-list li {
    display: grid;
    gap: 0.3rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
  .record-period {
    color: var(--accent);
  }
  .record-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 480;
    line-height: 1.3;
  }
  .record-place {
    font-size: var(--size-small);
    color: var(--text-2);
    font-style: italic;
  }
  .record-note {
    font-size: 0.92rem;
    color: var(--text-2);
    max-width: 52ch;
  }

  @media (max-width: 60rem) {
    .about-grid,
    .records {
      grid-template-columns: 1fr;
    }
    .portrait {
      position: static;
      max-width: 24rem;
    }
  }
</style>
