@article{TBME2025_RBD,
   abstract = {Musculoskeletal spine models that neglect intra-abdominal pressure (IAP) and are computationally intensive limit their use in muscle recruitment optimization and machine learning applications. This paper presents a fast-solving, high-fidelity rigid-body dynamics (RBD) spine model of the lumbar spine inclusive of IAP. The model includes the pelvis, five lumbar vertebrae, a lumped thoracic spine, and the ribcage, adapted from MRI scans of a healthy adult male. Intervertebral discs are modeled as 3-DOF gimbal joints with nonlinear moment-rotation relationships, while spinal ligaments are represented as nonlinear tension-only springs. Two IAP modeling methods are implemented and evaluated. The model comprises 15 degrees of freedom constrained by 279 independent force-generating elements, with a compilation time of approximately 6 seconds and a simulation run time of 1.4 seconds. Lumbar segmental stiffness profiles were validated against in vivo literature data. The model demonstrates applicability for muscle recruitment optimization and provides an intuitive MATLAB-native tool for physiological spine loading visualization.},
   author = {Siril Teja Dukkipati and Mark Driscoll},
   doi = {10.1109/TBME.2025.3561692},
   issn = {0018-9294},
   issue = {10},
   journal = {IEEE Transactions on Biomedical Engineering},
   month = {10},
   pages = {3108-3119},
   publisher = {IEEE},
   title = {Evaluation of a Fast-Solving Rigid Body Spine Model Inclusive of Intra-Abdominal Pressure},
   volume = {72},
   url = {https://doi.org/10.1109/TBME.2025.3561692},
   year = {2025},
   abbr = {IEEE TBME},
   preview = {3Manu2024.png},
   bibtex_show = {true},
   html = {https://doi.org/10.1109/TBME.2025.3561692},
   dimensions = {true},
   selected = {true}
}

